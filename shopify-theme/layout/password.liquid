<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ shop.name | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Courier+Prime:wght@400;700&family=Anton&family=Kaushan+Script&family=Playfair+Display:ital,wght@0,900;1,700&family=Abril+Fatface&family=Bebas+Neue&family=Special+Elite&family=Archivo+Black&family=Oswald:wght@600&family=DM+Serif+Display&display=swap">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="app">{{ content_for_layout }}</main>
  <script src="{{ 'ransom.js' | asset_url }}" defer></script>
</body>
</html>
