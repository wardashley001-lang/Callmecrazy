<section class="h-hero" style="min-height:100vh">
  <div class="h-copy">
    <div class="lab">drop 01 — opening soon</div>
    <h1><span class="own">own your</span><span class="crz" data-ransom="crazy" data-seed="7">crazy</span></h1>
    <p class="hl"><mark>One of one. We dare you.</mark></p>
    {% form 'customer', class: 'signup' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <span class="callme">Call me?</span>
      <input type="email" name="contact[email]" placeholder="email for the next drop" required aria-label="Email">
      <button class="btn" type="submit">join the crazy</button>
      {% if form.posted_successfully? %}<p class="fineprint">You're in.</p>{% endif %}
    {% endform %}
    <details style="margin-top:2rem"><summary class="tiny">Enter with password</summary>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <input type="password" name="password" aria-label="Password" required>
        <button class="btn" type="submit">enter</button>
      {% endform %}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
