<div class="wrap" {{ section.shopify_attributes }}>
  <div class="sechead"><h2 class="big">{{ section.settings.heading }}</h2><a class="tiny" href="{{ section.settings.collection.url | default: routes.collections_url }}">View all →</a></div>
  <div class="grid">
    {%- for product in section.settings.collection.products limit: section.settings.count -%}
      {% render 'product-card', product: product, index: forloop.index0 %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "The drop",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "the drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Pieces to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "The drop" }]
}
{% endschema %}
