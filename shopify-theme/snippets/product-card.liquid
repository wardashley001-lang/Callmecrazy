{% doc %}
Renders a product card.
@param {product} product - The product to render
@param {boolean} [gone] - Show the sold state
{% enddoc %}
{%- liquid
  assign piece = product.metafields.custom.piece_number.value
  assign card_image_alt = product.featured_image.alt | default: product.title
-%}
<a class="card{% if gone %} gonecard{% endif %}" href="{{ product.url }}">
  <div class="img">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: class: 'photo', loading: 'lazy', widths: '400, 600, 800', alt: card_image_alt }}
    {% endif %}
    {% if gone or product.available == false %}
      <span class="gbadge">gone.</span>
    {% else %}
      <span class="badge">One of one</span>
    {% endif %}
  </div>
  <div class="row">
    <div>{% if piece != blank %}<div class="no">NO. {{ piece }}</div>{% endif %}<h3>{{ product.title | escape }}</h3></div>
    <div class="meta">{{ product.price | money }}</div>
  </div>
</a>
